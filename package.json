{
  "name": "vihaar-game",
  "description": "Four small open-source browser games, built on established engines and examples.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vihaar/game.git"
  },
  "author": "Vihaar and contributors",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/Vihaar/game/issues"
  },
  "homepage": "https://github.com/Vihaar/game#readme",
  "scripts": {
    "dev": "npm --prefix games/server-kart run dev",
    "build": "node scripts/games.mjs build",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "typecheck": "node scripts/games.mjs check",
    "dev:kart": "npm --prefix games/server-kart run dev",
    "dev:fold": "npm --prefix games/card-roguelike run dev",
    "dev:soup": "npm --prefix games/soup run dev",
    "dev:elevator": "npm --prefix games/elevator run dev",
    "setup:games": "node scripts/games.mjs install",
    "test": "node scripts/games.mjs test"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "phaser": "4.0.0",
    "terser": "^5.39.0"
  }
}
